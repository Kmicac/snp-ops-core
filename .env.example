NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/<db_name>?schema=public

JWT_SECRET=replace_with_a_very_long_random_secret_min_32_chars
JWT_EXPIRES_IN=12h

ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=replace_with_strong_password

S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
S3_BUCKET_NAME=replace_me
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=https://example-bucket.s3.amazonaws.com
S3_UPLOAD_PUBLIC_READ=false

EMAIL_FROM=no-reply@example.com
RESEND_API_KEY=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=snp_ops
POSTGRES_PORT=5432

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace_me
PGADMIN_PORT=5050
